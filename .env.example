# Nexon Open API
NEXON_OPEN_API_KEY=

# 애플리케이션 단위 초당 호출 한도다. 개발 단계 5, 서비스 단계 500.
# 넘기면 429가 돌아오고 그 응답도 호출로 집계될 수 있다.
NEXON_REQUESTS_PER_SECOND=5

# 호출 허가를 기다리는 상한이다. 넘기면 시간 초과로 끝낸다.
NEXON_PERMIT_MAX_WAIT=10s

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maplemetric
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 캐릭터 종합 조회 한 번이 Nexon을 최대 21회 부른다.
#
# min-refresh-interval  갱신 연타로 21회씩 소비하지 않게 하는 최소 간격
# collect-wait-timeout  같은 캐릭터를 이미 수집 중일 때 합류해 기다리는 상한
# max-collect-duration  수집을 맡은 요청 자신의 상한
CHARACTER_MIN_REFRESH_INTERVAL=5m
CHARACTER_COLLECT_WAIT_TIMEOUT=30s
CHARACTER_MAX_COLLECT_DURATION=30s

# profile 기본값이 없다. 지정하지 않으면 Actuator를 health 하나로 닫은 기본
# 설정만 적용된다. 로컬 개발은 반드시 지정한다.
SPRING_PROFILES_ACTIVE=local

# 내부 운영 API 인증 키
# 비어 있으면 /internal 요청이 전부 401로 막힌다. 수집·Backfill·Retention을
# 호출하려면 반드시 채운다.
MAPLEMETRIC_INTERNAL_API_KEY=

# 매일 09:40 KST 종합 랭킹 자동 수집
# 켜면 앱이 떠 있는 동안에만 동작한다. 그 시각에 꺼져 있으면 그날은 수집되지
# 않으므로, 빈 날은 Backfill로 메운다.
RANKING_COLLECTION_SCHEDULER_ENABLED=false

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CONNECT_TIMEOUT=3s
OPENAI_READ_TIMEOUT=10s

# 통계 설명 생성 한도다. 유료 호출이므로 잘못된 실행 한 번이 예산을 소진하지
# 않아야 한다. 기본이 90일인 이유는 하루·일주일 변화가 노이즈이기 때문이다.
STATISTICS_INSIGHT_MAX_PER_RUN=70
STATISTICS_INSIGHT_RANGE_PRESET=90D

# 종합 랭킹 정기 수집
RANKING_COLLECTION_MAX_PAGES=10
RANKING_COLLECTION_SCHEDULER_CRON=0 40 9 * * *
RANKING_COLLECTION_SCHEDULER_ZONE=Asia/Seoul

# 과거 Snapshot 채우기
# request-interval은 Nexon 공식 수치가 아니라 과거 데이터를 몰아 받지 않기 위한
# 보수적인 값이다. stale-claim-timeout은 강제 종료로 점유된 채 남은 기준일을
# 회수하는 기준이라, 한 기준일의 정상 수집 소요보다 넉넉해야 한다.
RANKING_BACKFILL_MAX_PAGES=10
RANKING_BACKFILL_MAX_ATTEMPTS_PER_DATE=3
RANKING_BACKFILL_MAX_DATES_PER_RUN=7
RANKING_BACKFILL_REQUEST_INTERVAL=2s
RANKING_BACKFILL_STALE_CLAIM_TIMEOUT=10m

# 수집 결과 보존 한도
# 기본이 꺼짐이다. 삭제는 되돌릴 수 없고 보존 일수도 아직 운영 데이터를 측정해
# 확정하지 않았다. 켜기 전에 RANKING_RETENTION_DAYS를 다시 정한다.
RANKING_RETENTION_ENABLED=false
RANKING_RETENTION_DAYS=1095
RANKING_RETENTION_MAX_DATES_PER_RUN=30
