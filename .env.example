# Nexon Open API
NEXON_OPEN_API_KEY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maplemetric
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

SPRING_PROFILES_ACTIVE=local

# 내부 운영 API 인증 키
# 비어 있으면 /internal 요청이 전부 401로 막힌다. 수집·Backfill·Retention을
# 호출하려면 반드시 채운다.
MAPLEMETRIC_INTERNAL_API_KEY=

# 매일 09:40 KST 종합 랭킹 자동 수집
# 켜면 앱이 떠 있는 동안에만 동작한다. 그 시각에 꺼져 있으면 그날은 수집되지
# 않으므로, 빈 날은 Backfill로 메운다.
RANKING_COLLECTION_SCHEDULER_ENABLED=false

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ENABLED=false
