        );

        client.assert(
            body.success === false,
            "success가 false가 아닙니다."
        );

        client.assert(
            body.code === "GLOBAL_001",
            "에러 코드가 GLOBAL_001이 아닙니다. 실제 코드: "
            + body.code
        );
    });
%}

### 캐릭터명 파라미터 누락
# GLOBAL_001
GET {{host}}/api/v1/characters/search
Accept: application/json

> {%
    const body = response.body || {};

    client.test("캐릭터명 누락은 400을 반환한다", function () {
        client.assert(
            response.status === 400,
            "응답 상태가 400이 아닙니다. 실제 상태: "
            + response.status
        );

        client.assert(
            body.success === false,
            "success가 false가 아닙니다."
        );

        client.assert(
            body.code === "GLOBAL_001",
            "에러 코드가 GLOBAL_001이 아닙니다. 실제 코드: "
            + body.code
        );
    });
%}