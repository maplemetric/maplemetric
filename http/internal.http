### 내부 운영 API
#
# 모든 요청에 X-Internal-API-Key가 필요하다. 키는 .env의
# MAPLEMETRIC_INTERNAL_API_KEY에서 읽으며 이 파일에 적지 않는다.
# 키가 비어 있으면 전부 401로 막힌다.
#
# 이 요청들은 실제 Nexon을 호출한다. 개발 단계 한도는 하루 1000회이고
# 수집 한 번이 기준일당 10회를 쓴다.

@baseUrl = http://localhost:8080
@internalApiKey = {{$dotenv MAPLEMETRIC_INTERNAL_API_KEY}}

### 오늘 종합 랭킹 수집 (10회)
POST {{baseUrl}}/internal/v1/collections/rankings/overall
X-Internal-API-Key: {{internalApiKey}}
Content-Type: application/json

{}

### 특정 기준일 수집 (10회)
POST {{baseUrl}}/internal/v1/collections/rankings/overall
X-Internal-API-Key: {{internalApiKey}}
Content-Type: application/json

{
  "rankingDate": "2026-07-26",
  "maxPages": 10
}


### Backfill 1단계 — 하루만 시험 (10회)
#
# 넥슨이 과거 기준일을 실제로 돌려주는지 먼저 확인한다. 응답 기준일 상태가
# SUCCEEDED면 그 뒤 구간을 이어서 채우고, FAILED면 lastErrorType을 보고
# 계획을 다시 세운다.
POST {{baseUrl}}/internal/v1/backfills/rankings/overall
X-Internal-API-Key: {{internalApiKey}}
Content-Type: application/json

{
  "from": "2026-07-26",
  "to": "2026-07-26"
}

> {%
    client.global.set(
        "backfillJobId",
        response.body.data.backfillJobId
    );
%}

### Backfill 2단계 — 한 배치 실행
#
# 한 번에 max-dates-per-run(기본 7일)까지만 처리하고 돌아온다.
# processedDateCount가 상한과 같으면 남은 기준일이 있다는 뜻이라 다시 호출한다.
# 0이면 끝났다.
POST {{baseUrl}}/internal/v1/backfills/rankings/overall/{{backfillJobId}}/runs
X-Internal-API-Key: {{internalApiKey}}

### Backfill 3단계 — 상태와 기준일 확인
GET {{baseUrl}}/internal/v1/backfills/rankings/overall/{{backfillJobId}}
X-Internal-API-Key: {{internalApiKey}}


### Backfill — 끊긴 구간 메우기 (7일, 70회)
#
# 시험이 성공한 뒤에 돌린다. 실행은 위 2단계를 processedDateCount가 0이 될
# 때까지 반복한다.
POST {{baseUrl}}/internal/v1/backfills/rankings/overall
X-Internal-API-Key: {{internalApiKey}}
Content-Type: application/json

{
  "from": "2026-07-27",
  "to": "2026-08-02"
}

> {%
    client.global.set(
        "backfillJobId",
        response.body.data.backfillJobId
    );
%}

### Backfill — 30일 확보 (22일, 220회)
#
# 30D 프리셋이 의미를 갖는 최소선이다. 위 구간 메우기가 끝난 뒤에 돌린다.
POST {{baseUrl}}/internal/v1/backfills/rankings/overall
X-Internal-API-Key: {{internalApiKey}}
Content-Type: application/json

{
  "from": "2026-07-04",
  "to": "2026-07-25"
}

> {%
    client.global.set(
        "backfillJobId",
        response.body.data.backfillJobId
    );
%}


### 보존 만료 대상 산정 (Dry Run)
#
# 아무것도 지우지 않는다. 만료가 꺼져 있어도 조회된다.
GET {{baseUrl}}/internal/v1/retentions/rankings/overall/plan
X-Internal-API-Key: {{internalApiKey}}

### 보존 만료 실행 — 되돌릴 수 없다
#
# RANKING_RETENTION_ENABLED=true일 때만 동작하고, 꺼져 있으면 409로 거부한다.
# 위 산정 결과를 먼저 확인한다.
POST {{baseUrl}}/internal/v1/retentions/rankings/overall/expirations
X-Internal-API-Key: {{internalApiKey}}


### 통계 인사이트 생성 — 유료 호출
#
# OPENAI_ENABLED=true이면 실제 OpenAI를 호출한다. Scheduler가 없으므로
# 사람이 직접 실행하는 유일한 경로다.
#
# 한 번의 실행은 STATISTICS_INSIGHT_MAX_PER_RUN까지만 만든다.
# hasMore가 true면 한도 때문에 멈춘 것이므로 다시 호출한다. generated를 한도와
# 비교해 짐작하지 않는다. 정확히 마지막까지 만들고 끝난 경우와 건수가 같다.
#
# alreadyExists는 넘어가도 된다. noHistory는 수집된 기준일이 없다는 뜻이라
# 확인이 필요하다.
POST {{baseUrl}}/internal/v1/insights/statistics
X-Internal-API-Key: {{internalApiKey}}

> {%
    const data = (response.body || {}).data || {};

    client.test("인사이트 생성 응답 계약을 지킨다", function () {
        client.assert(
            response.status === 200,
            "응답 상태가 200이 아닙니다. 실제 상태: "
            + response.status
        );

        client.assert(
            response.body.code === "STATISTICS_INSIGHT_GENERATED",
            "성공 코드가 올바르지 않습니다. 실제 코드: "
            + response.body.code
        );

        client.assert(
            "generated" in data
            && "alreadyExists" in data
            && "noHistory" in data
            && "failed" in data
            && "hasMore" in data,
            "generated / alreadyExists / noHistory / failed / hasMore "
            + "필드가 모두 있지 않습니다."
        );
    });

    client.log(
        "생성 " + data.generated
        + " / 이미있음 " + data.alreadyExists
        + " / 기준일없음 " + data.noHistory
        + " / 실패 " + data.failed
        + " / 남음 " + data.hasMore
    );

    if (data.hasMore) {
        client.log(
            "한도 때문에 멈췄습니다. 남은 대상을 위해 다시 호출한다."
        );
    }

    if (data.noHistory > 0) {
        client.log(
            "수집된 기준일이 없어 건너뛴 대상이 있습니다. 수집 상태를 확인한다."
        );
    }

    if (data.failed > 0) {
        client.log(
            "실패한 대상이 있습니다. 서버 WARN 로그에서 원인을 확인한다."
        );
    }
%}
